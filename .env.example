# -----------------------------------------------------------------------------
# MUSICED environment variables
# Copy to .env.local for local development. Never commit real values.
# -----------------------------------------------------------------------------

# Public site URL (used for auth redirects, sharing links, metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. For local dev, `npx supabase status` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (client-safe) key. Legacy "anon" JWT keys also work here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. Secret / service-role key. Used exclusively for system tasks:
# catalog ingestion, rate limiting, billing webhooks. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Show "Continue with Google" (requires the Google provider to be configured
# in Supabase: Dashboard > Auth > Providers, or supabase/config.toml locally).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# MusicBrainz requires a meaningful User-Agent with contact information:
# https://musicbrainz.org/doc/MusicBrainz_API/Rate_Limiting
MUSICBRAINZ_USER_AGENT="MUSICED/0.1 ( https://your-domain.example )"

# Optional: Last.fm enrichment (future phase).
LASTFM_API_KEY=

# Optional: POST server errors as JSON to this URL (Sentry/Better Stack/Slack ingest, etc.).
ERROR_WEBHOOK_URL=
